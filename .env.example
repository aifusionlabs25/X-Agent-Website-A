# Public/server configuration
ANAM_API_KEY=
ANAM_AMY_CARA4_PERSONA_ID=

# Optional primary street-address geocoder. Without it, Evan uses the U.S. Census address-range geocoder.
GEOAPIFY_API_KEY=

# Amy session spine and Redis
AMY_ANAM_SESSION_SPINE_ENABLED=true
AMY_ANAM_SESSION_SPINE_KILL_SWITCH=false
AMY_ANAM_SESSION_SECRET=
AMY_ANAM_REDIS_REST_URL=
AMY_ANAM_REDIS_REST_TOKEN=

# Returning-user memory
AMY_ANAM_MEMORY_ENABLED=true
AMY_ANAM_MEMORY_KILL_SWITCH=false
AMY_ANAM_MEMORY_ACCESS_CODE=
AMY_ANAM_MEMORY_IDENTITY_SALT=
AMY_ANAM_MEMORY_OPERATOR_SECRET=
AMY_ANAM_MEMORY_PROMOTION_ENABLED=true
AMY_ANAM_MEMORY_PROMOTION_KILL_SWITCH=false

# Locks Production to the reviewed Redis URL/token/salt combination.
AMY_ANAM_MEMORY_CONFIG_FINGERPRINT=

# Hermes backend bridge
AMY_ANAM_HERMES_SHADOW_ENABLED=true
AMY_ANAM_HERMES_SHADOW_KILL_SWITCH=false
AMY_ANAM_HERMES_SHADOW_MODE=shadow
AMY_ANAM_HERMES_WORKER_SECRET=

# AgentMail
AMY_EMAIL_PROVIDER=agentmail
AMY_AGENTMAIL_ADDRESS=amy-insight@agentmail.to
AMY_VISITOR_EMAIL_PROVIDER=agentmail
AMY_RESEND_FROM_ADDRESS=Amy from X Agents <hello@aifusionlabs.app>
AGENTMAIL_API_KEY=
RESEND_API_KEY=
AMY_ANAM_AGENTMAIL_ENABLED=true
AMY_ANAM_AGENTMAIL_KILL_SWITCH=false

# Dani website session and encrypted-contact boundary. Production requires two
# distinct random secrets; neither may reuse Amy's session secret or ANAM_API_KEY.
DANI_ANAM_SESSION_SECRET=
DANI_ANAM_CONTACT_SECRET=

# Dani returning memory. Keep both read and promotion paths fail-closed until
# the backend, dedicated Anam identity tool, prompt, and manual publish are verified.
DANI_ANAM_MEMORY_ENABLED=false
DANI_ANAM_MEMORY_KILL_SWITCH=true
DANI_ANAM_REDIS_REST_URL=
DANI_ANAM_REDIS_REST_TOKEN=
DANI_ANAM_MEMORY_IDENTITY_SALT=
# Exactly 32 bytes encoded as base64, or 64 hexadecimal characters.
DANI_ANAM_MEMORY_ENCRYPTION_KEY=
DANI_ANAM_MEMORY_VERIFICATION_SECRET=
DANI_ANAM_MEMORY_PROMOTION_ENABLED=false
DANI_ANAM_MEMORY_PROMOTION_KILL_SWITCH=true
DANI_ANAM_MEMORY_OPERATOR_SECRET=
# Local operator CLI only; use the exact reviewed deployment endpoint.
DANI_ANAM_MEMORY_CANDIDATE_URL=
DANI_ANAM_MEMORY_PROMOTION_URL=
# SHA-256 over Dani's Redis URL/token, identity salt, encryption key, and
# verification secret in the documented order. Required only when memory is open.
DANI_ANAM_MEMORY_CONFIG_FINGERPRINT=

# Dani AI Solutions Director three-email bundle. Production uses explicit Dani
# gates even though the runtime retains legacy Amy-gate inheritance for rollback.
DANI_EMAIL_PROVIDER=agentmail
DANI_AGENTMAIL_ADDRESS=hermes-hal@agentmail.to
DANI_ADMIN_EMAIL=aifusionlabs@gmail.com
DANI_CALL_SUMMARY_EMAIL=aifusionlabs@gmail.com
DANI_ANAM_AGENTMAIL_ENABLED=true
DANI_ANAM_AGENTMAIL_KILL_SWITCH=false
DANI_ANAM_TOOLS_ENABLED=true
DANI_ANAM_TOOLS_KILL_SWITCH=false
DANI_ANAM_OUTBOUND_ACTIONS_ENABLED=true
DANI_ANAM_OUTBOUND_ACTIONS_KILL_SWITCH=false

# Dani post-session email retry worker. The two daily Vercel cron slots share
# CRON_SECRET and run 12 hours apart, safely inside AgentMail's 24-hour key TTL.
DANI_ANAM_EMAIL_RECOVERY_ENABLED=true
DANI_ANAM_EMAIL_RECOVERY_KILL_SWITCH=false
DANI_ANAM_EMAIL_RECOVERY_PRODUCTION_APPROVED=true
# Optional operator-only bearer; scheduled Vercel calls use CRON_SECRET.
DANI_ANAM_EMAIL_RECOVERY_SECRET=
CRON_SECRET=

# Live action gates. All must be open before Amy may send.
AMY_ANAM_TOOLS_ENABLED=true

# Evan Mullins AgentMail. These override the shared Amy gates; when omitted, Evan inherits the open shared gates.
EVAN_EMAIL_PROVIDER=agentmail
EVAN_AGENTMAIL_ADDRESS=hermes-hal@agentmail.to
EVAN_MULLINS_ADMIN_EMAIL=aifusionlabs@gmail.com
EVAN_MULLINS_SALES_EMAIL=aifusionlabs@gmail.com
EVAN_ANAM_AGENTMAIL_ENABLED=true
EVAN_ANAM_AGENTMAIL_KILL_SWITCH=false
EVAN_ANAM_TOOLS_ENABLED=true
EVAN_ANAM_TOOLS_KILL_SWITCH=false
EVAN_ANAM_OUTBOUND_ACTIONS_ENABLED=true
EVAN_ANAM_OUTBOUND_ACTIONS_KILL_SWITCH=false
AMY_ANAM_TOOLS_KILL_SWITCH=false
AMY_ANAM_OUTBOUND_ACTIONS_ENABLED=true
AMY_ANAM_OUTBOUND_ACTIONS_KILL_SWITCH=false

# James AI Fusion Labs demo email. Public notes-only calls stay available.
# Use a dedicated James inbox with display name AI Fusion Labs Demo.
JAMES_DEMO_EMAIL_ENABLED=false
JAMES_AGENTMAIL_ADDRESS=james-demo@agentmail.to
JAMES_DEMO_REPLY_TO=aifusionlabs@gmail.com
# Optional dedicated key; when omitted, the server uses AGENTMAIL_API_KEY.
JAMES_AGENTMAIL_API_KEY=
# Reusable private operator code: store only its SHA-256 digest, never the code.
# Default one-use preserves the original expiring qualification workflow.
JAMES_DEMO_EMAIL_ACCESS_MODE=one-use
# visitor removes the code step. Requires a bounded per-24-hour allowance of
# summary pairs (two emails per pair); suggested initial demo limit: 25.
JAMES_DEMO_EMAIL_DAILY_SEND_LIMIT=
JAMES_DEMO_EMAIL_ACCESS_SHA256=
# Required only in one-use mode; reusable mode grants 24 hours per new call.
JAMES_DEMO_EMAIL_EXPIRES_AT=

# Public/server configuration
ANAM_API_KEY=
ANAM_AMY_CARA4_PERSONA_ID=

# Amy session spine and Redis
AMY_ANAM_SESSION_SPINE_ENABLED=true
AMY_ANAM_SESSION_SPINE_KILL_SWITCH=false
AMY_ANAM_SESSION_SECRET=
AMY_ANAM_REDIS_REST_URL=
AMY_ANAM_REDIS_REST_TOKEN=

# Returning-user memory
AMY_ANAM_MEMORY_ENABLED=true
AMY_ANAM_MEMORY_KILL_SWITCH=false
AMY_ANAM_MEMORY_ACCESS_CODE=
AMY_ANAM_MEMORY_IDENTITY_SALT=
AMY_ANAM_MEMORY_OPERATOR_SECRET=
AMY_ANAM_MEMORY_PROMOTION_ENABLED=true
AMY_ANAM_MEMORY_PROMOTION_KILL_SWITCH=false

# Locks Production to the reviewed Redis URL/token/salt combination.
AMY_ANAM_MEMORY_CONFIG_FINGERPRINT=

# Hermes backend bridge
AMY_ANAM_HERMES_SHADOW_ENABLED=true
AMY_ANAM_HERMES_SHADOW_KILL_SWITCH=false
AMY_ANAM_HERMES_SHADOW_MODE=shadow
AMY_ANAM_HERMES_WORKER_SECRET=

# AgentMail
AMY_EMAIL_PROVIDER=agentmail
AMY_AGENTMAIL_ADDRESS=amy-insight@agentmail.to
AGENTMAIL_API_KEY=
